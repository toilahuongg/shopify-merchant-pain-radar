{
  "name": "merchant-signal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Merchant pain discovery engine for ecommerce/Shopify communities, running on Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "wrangler d1 create merchant-signal",
    "db:migrate:local": "wrangler d1 migrations apply merchant-signal --local",
    "db:migrate:remote": "wrangler d1 migrations apply merchant-signal --remote",
    "queue:create": "wrangler queues create pain-signals && wrangler queues create pain-signals-dlq",
    "cron:test:collect": "wrangler dev --test-scheduled",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "wrangler": "^3.99.0"
  }
}
